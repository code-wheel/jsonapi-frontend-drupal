<?php

/**
 * @file
 * Hook implementations for JSON:API Frontend module.
 *
 * Procedural implementations are LegacyHook shims for Drupal 10/11.0;
 * the logic lives in \Drupal\jsonapi_frontend\Hook\JsonapiFrontendHooks,
 * which Drupal 11.1+ and 12 discover directly.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\jsonapi_frontend\Hook\JsonapiFrontendHooks;

/**
 * Implements hook_entity_insert().
 */
#[LegacyHook]
function jsonapi_frontend_entity_insert(EntityInterface $entity): void {
  \Drupal::service(JsonapiFrontendHooks::class)->entityInsert($entity);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function jsonapi_frontend_entity_update(EntityInterface $entity): void {
  \Drupal::service(JsonapiFrontendHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function jsonapi_frontend_entity_delete(EntityInterface $entity): void {
  \Drupal::service(JsonapiFrontendHooks::class)->entityDelete($entity);
}
