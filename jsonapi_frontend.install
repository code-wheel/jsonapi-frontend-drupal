<?php

/**
 * @file
 * Install, update and uninstall functions for JSON:API Frontend.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\Core\Url;
use Drupal\jsonapi_frontend\Hook\JsonapiFrontendHooks;

/**
 * Implements hook_requirements().
 *
 * LegacyRequirementsHook shim for Drupal 10/11.x; Drupal 11.2+ and 12 use
 * JsonapiFrontendHooks::runtimeRequirements() directly.
 */
#[LegacyRequirementsHook]
function jsonapi_frontend_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  return \Drupal::service(JsonapiFrontendHooks::class)->runtimeRequirements();
}

/**
 * Implements hook_install().
 */
function jsonapi_frontend_install(): void {
  \Drupal::messenger()->addStatus(t('JSON:API Frontend installed. <a href=":url">Configure your headless settings</a>.', [
    ':url' => Url::fromRoute('jsonapi_frontend.settings')->toString(),
  ]));
}

/**
 * Implements hook_uninstall().
 */
function jsonapi_frontend_uninstall(): void {
  // Configuration is automatically deleted by Drupal.
  \Drupal::messenger()->addStatus(t('JSON:API Frontend has been uninstalled.'));
}
